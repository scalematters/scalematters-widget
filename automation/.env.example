# These are only used for running the pipeline locally. In production they're
# GitHub Actions repository secrets (Settings → Secrets and variables →
# Actions), never committed here.

# Salesforce — Connected App configured for the OAuth 2.0 Client Credentials flow
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_INSTANCE_URL=

# Gong — Company Settings → Ecosystem → API
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=

# Google Drive — a service account JSON key, base64-encoded as one line
# (e.g. `base64 -i service-account.json | tr -d '\n'`)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
DRIVE_CUSTOMER_FOLDER_ID=
DRIVE_AGENCY_FOLDER_ID=

# Anthropic — same key already used by the widget's api/chat.js
ANTHROPIC_API_KEY=

# HubSpot — a private app with blog-post read/write scope
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_BLOG_ID=

# GitHub — only needed for local testing; in Actions these are provided
# automatically by the runner
GITHUB_TOKEN=
GITHUB_REPOSITORY=scalematters/scalematters-widget
