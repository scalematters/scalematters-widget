# Anthropic API key used by api/chat.js to call Claude. Never exposed to the browser.
ANTHROPIC_API_KEY=

# Origin allowed to call /api/chat (CORS lock-down). Production value: https://www.scalematters.com
ALLOWED_ORIGIN=https://www.scalematters.com

# Postgres connection string — auto-set by Vercel when you add the Postgres storage integration.
POSTGRES_URL=

# Upstash Redis — auto-set by Vercel when you add the Upstash integration (used for per-IP rate limiting).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Slack Bot Token (starts with xoxb-) from a Slack app with the chat:write scope,
# and the ID of the channel it should post conversations into.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
